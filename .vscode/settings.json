{
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "explicit",
            "source.organizeImports.ruff": "explicit"
        }
    },

    "python.analysis.typeCheckingMode": "basic",
    
    "notebook.output.scrolling": true,
    "notebook.output.textLineLimit": 30,
    "notebook.diff.ignoreOutputs": false,
    "interactiveWindow.collapseCellInputCode": "never",

    "workbench.colorCustomizations": {
        "activityBar.activeBackground": "#2badc3",
        "activityBar.background": "#2badc3",
        "activityBar.foreground": "#15202b",
        "activityBar.inactiveForeground": "#15202b99",
        "activityBarBadge.background": "#b728a2",
        "activityBarBadge.foreground": "#e7e7e7",
        "commandCenter.border": "#e7e7e799",
        "sash.hoverBorder": "#2badc3",
        "statusBar.background": "#228899",
        "statusBar.foreground": "#e7e7e7",
        "statusBarItem.hoverBackground": "#2badc3",
        "statusBarItem.remoteBackground": "#821d74",
        "statusBarItem.remoteForeground": "#e7e7e7",
        "titleBar.activeBackground": "#228899",
        "titleBar.activeForeground": "#e7e7e7",
        "titleBar.inactiveBackground": "#22889999",
        "titleBar.inactiveForeground": "#e7e7e799",
        "activityBarTop.activeBackground": "#2badc3",
        "activityBarTop.background": "#2badc3",
        "activityBarTop.foreground": "#15202b",
        "activityBarTop.inactiveForeground": "#15202b99",
        "commandCenter.foreground": "#e7e7e7",
        "statusBar.debuggingBackground": "#228899",
        "statusBar.debuggingForeground": "#e7e7e7"
    },
    "peacock.color": "#228899FF"
}