#################################################################################################################
# Start with base (usually someone elses container/image)
#################################################################################################################

# we start off with an image that contains C#
FROM mcr.microsoft.com/dotnet/sdk8.0 AS base

# "install" uv for dependency management
# i.e. copy the uv and uvx (executable binaries) folders from the official Astral uv Docker image directly into the /bin/ directory of your current image.
COPY --from=ghcr.io/astral-sh/uv:0.11.25 /uv /uvx /bin/

# "install" litestream for database backups
# i.e. copy litestream (executable binaries) folders from the official litestream image directly into the /bin/ directory of your current image.
COPY --from=litestream/litestream:0.3.13 /usr/local/bin/litestream /bin/

# Make the folder executable so that we can call `uv sync` etc
# RUN chmod +x /bin/uv
# RUN chmod +x /bin/litestream
# RUN apt-get update && apt-get install -y libstdc++6








#################################################################################################################
# Set up certificates
#################################################################################################################

# RUN apt-get update && apt-get install -y libgdiplus apt-utilds libc6ev

# install CA certs
# RUN apt-get update && apt-get install -y ca-certificates







#################################################################################################################
# Expose the ports the container will use to talk to the surrounding system 
#################################################################################################################

EXPOSE 8080
# EXPOSE 443








