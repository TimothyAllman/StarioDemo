# RUN az storage blob download -n "mycoolcompany_Root_CA_2026.crt" -f mycoolcompany_Root_CA_2026.crt -c certificates --account-name abcxyzeun --account-key $MY_COOL_ACCOUNT_KEY 




#################################################################################################################
# Copy everything we need from our local repo to the image
#################################################################################################################
FROM base AS copyallfilesstep

COPY ["./pyproject.toml", "./workingdirectory/pyproject.toml"]
COPY ["./README.md", "./workingdirectory/README.md"]
COPY ["./src", "./workingdirectory/src"]
COPY ["./main.py", "./workingdirectory/main.py"]
COPY ["./piccolo_conf.py", "./workingdirectory/piccolo_conf.py"]
COPY ["./uv.lock", "./workingdirectory/uv.lock"]
COPY ["./.python-version", "./workingdirectory/.python-version"]
COPY ["./.scripts/UvRunStarioServeMainBootstrap.py", "./.scripts/UvRunStarioServeMainBootstrap.py"]









#################################################################################################################
# Install Dependencies
#################################################################################################################
FROM copyallfilesstep AS installalldependenciesstep


# Place the certs in the special linux folder and change permissions on them
COPY --from=certificatestep /tmp /usr/local/share/ca-certificates/
RUN chmod 644 /usr/local/share/ca-certificates/mycoolcompany_Issuing_CA_2026.crt
RUN chmod 644 /usr/local/share/ca-certificates/mycoolcompany_Root_CA_2026.crt && update-ca-certificates




# First pull in anything etc we might need
ARG PAT 
# i.e. must pass this in when we call docker build 
# e.g. docker build -PAT='23haon108h0ak' 
# e.g. docker build -PAT= {{mycoolpat}}




# set up environement variables that uv will use
ENV UV_INDEX_MYNAMEOFPRIVATEPYPIFEED_PASSWORD=$PAT
ENV UV_INDEX_MYNAMEOFPRIVATEPYPIFEED_USERNAME="aUserNameTHatDoesNotMatter"

# just some logging to check the env var exist
RUN echo $UV_INDEX_MYNAMEOFPRIVATEPYPIFEED_USERNAME

# when this shows up in the terminal it is printed as stars i.e. ***** 
RUN echo $UV_INDEX_MYNAMEOFPRIVATEPYPIFEED_PASSWORD

# set up other environment variables
ENV UV_SYSTEM_CERTS=true
ENV STARIO_PORT=8080
ENV STARIO_HOST=0.0.0.0
env STARIO_TRACER=tty

# install all dependencies and sync the lock file
RUN uv sync 





#################################################################################################################
# Finally use all the files to get the website up
#################################################################################################################
FROM installalldependenciesstep AS finalstep

# Place the executables in the environment at the front of the path
ENV PATH="/workingdirectory/.venv/bin:$PATH"


# create the command docker will run when it creates a container i.e. the entry point for the application
ENTRYPOINT ["python", ".scripts/UvRunStarioServeMainBootstrap.py" ]



